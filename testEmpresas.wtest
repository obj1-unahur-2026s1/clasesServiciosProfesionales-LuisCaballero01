import empresas.*
import profesionales.*
import universidades.*

describe "group of tests for pepita" {
    method initialize() {
      laSerenisima.contratarProfesionales([juana, melina, rocio, luciana])
    }
    test "Dos profesionales estudiaron en uniRosario" {
        assert.equals(2, laSerenisima.cuantosEstudiaronEn(uniRosario))
    }
    test "Un profesional estudio en uniHurlingham" {
        assert.equals(1, laSerenisima.cuantosEstudiaronEn(uniHurlingham))
    }
    test "Ningun profesional estudio en uniSanMartin" {
        assert.equals(0, laSerenisima.cuantosEstudiaronEn(uniSanMartin))
    }

    test "Rocio es el unico profesional caro"{
        assert.equals([rocio], laSerenisima.profesionalesCaros())
    }
    test "Las universidades formadoras son uniRosario, uniCorrientes y uniHurlingham" {
        assert.equals(#{uniRosario, uniCorrientes, uniHurlingham}, laSerenisima.universidadesFormadoras())
    }
    test "Juana es la más barata"{
        assert.equals(juana, laSerenisima.profesionalMasBarato())
    }
    test "La laSerenisima no es de gente acotada"{
        assert.notThat(laSerenisima.esDeGenteAcotada())
    }
}